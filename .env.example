# ocr-worker only -- api-gateway never calls the vision API directly.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Shared by api-gateway and ocr-worker. Defaults shown match
# infra/docker/docker-compose.yml; override for standalone `cargo run`
# against a locally-running Kafka/Redis instead of Compose.
KAFKA_BROKERS=localhost:9092
REDIS_URL=redis://localhost:6379

# api-gateway only.
PORT=8080

# ocr-worker only.
KAFKA_CONSUMER_GROUP=ocr-worker-group
