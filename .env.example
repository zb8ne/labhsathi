# ocr-worker only -- api-gateway never calls the vision API directly.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Shared by api-gateway and ocr-worker. Defaults shown match
# infra/docker/docker-compose.yml; override for standalone `cargo run`
# against a locally-running Kafka/Redis instead of Compose.
KAFKA_BROKERS=localhost:9092
REDIS_URL=redis://localhost:6379

# api-gateway only.
PORT=8080
CATALOG_SERVICE_URL=http://localhost:8090

# ocr-worker only.
KAFKA_CONSUMER_GROUP=ocr-worker-group

# catalog-service only -- must be a real reachable Postgres; see
# infra/docker/docker-compose.yml for the matching local credentials, or
# `docker run --rm -d -p 5432:5432 -e POSTGRES_PASSWORD=labhsathi_dev_only
# -e POSTGRES_USER=labhsathi -e POSTGRES_DB=labhsathi_catalog postgres:16-alpine`
# for a quick standalone one.
DATABASE_URL=postgres://labhsathi:labhsathi_dev_only@localhost:5432/labhsathi_catalog
