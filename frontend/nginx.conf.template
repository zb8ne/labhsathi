server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # GitHub issue #15 (product review): labhsathi.info sent none of these.
    # Kept deliberately conservative rather than a maximally strict policy
    # -- this templates the same one nginx.conf across Compose/kind/Railway
    # (see docker-entrypoint.sh), and the live site can't be iterated on
    # live tonight if a stricter policy turned out to break something.
    #   - nosniff / frame-options / referrer-policy: zero behavioral risk,
    #     no reason not to have them.
    #   - HSTS: Railway already terminates TLS in front of this container
    #     (nginx itself still just serves plain HTTP internally, unchanged)
    #     -- a short max-age rather than a long one with preload, since
    #     that's much easier to walk back if it ever needs to be.
    #   - CSP: script-src needs 'unsafe-inline' for the two inline
    #     <script> blocks in index.html (the runtime __LABHSATHI_CONFIG__
    #     fallback and the pre-hydration dark-mode-flash guard) -- a
    #     stricter nonce/hash-based policy is real future work, not
    #     something to get right unverified in one pass. connect-src stays
    #     permissive-on-https rather than pinned to one Railway hostname,
    #     since API_BASE_URL is a runtime value (env.js, written by
    #     docker-entrypoint.sh) this template has no build-time knowledge
    #     of. Still meaningfully tightens the default-src/object-src/
    #     frame-ancestors surface either way.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;

    # GitHub issue #2: the kind demo runs with ingress disabled and the
    # frontend defaulting to same-origin /api (see api-gateway Helm
    # values), but nothing was actually proxying /api anywhere -- every
    # API call 404'd. $API_PROXY_PASS is substituted by docker-entrypoint.sh
    # from an env var at container start. Compose and Railway don't need
    # this at all (API_BASE_URL there is an absolute cross-origin URL, so
    # the browser calls api-gateway directly and never hits this block) --
    # the default below is a deliberately-refused local port so an
    # unconfigured proxy fails loudly (502) instead of silently misrouting.
    location /api/ {
        proxy_pass ${API_PROXY_PASS};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # React Router client-side routing -- unknown paths fall through to
    # index.html rather than 404ing on a hard refresh of /results or /privacy.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # env.js is written by docker-entrypoint.sh at container start; never
    # cache it, or a redeploy with a new API_BASE_URL won't take effect for
    # a client with a cached copy.
    location = /env.js {
        add_header Cache-Control "no-store";
    }
}
